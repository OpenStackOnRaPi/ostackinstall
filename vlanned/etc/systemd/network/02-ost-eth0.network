# Definitions of tagged VLANs
# We use systemd files because tagged VLANs cannot currently be set in netplan (this may change someday)

[Match]
Name=eth0
#Type=ether

[Network]
Bridge=brmux

# OPTIONAL VLAN (VLAN2): for a flat provider external network extending across the physical network infrastructure.
# - this VLAN will be invisible at the OpenStack level - in brmux, it will be replaced by
# VLAN1 (untagged) and OpenStack will receive it as "flat"
# - in fact, it can be omitted at all and a standard untagged Ethernet could be used, but we
# are introducing it (as an option) for educational purposes to better highlight the role of VLAN provider networks.
# Uncomment the lines below to enable VLAN2 for OpenStack "flat provider network" traffic.
#[BridgeVLAN]
#VLAN=2

# VLANs for VLAN provider networks (implemented as tagged VLANs)
# for educational purposes - three VLANs are completely sufficient
[BridgeVLAN]
VLAN=101-103
